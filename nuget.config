<?xml version="1.0" encoding="utf-8"?>
<!-- Hermetic sources: nuget.org plus the TerraScale Forgejo registry, nothing
     inherited from user or machine config. Source mapping decides where each
     package restores from (required with central package management; without it
     NU1507 fails the build under TreatWarningsAsErrors). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="terrascale" value="https://git.terrascale.tech/api/packages/TerraScale/nuget/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <!-- TerraScale-published packages (e.g. TerraScale.Logging) come only from Forgejo. -->
    <packageSource key="terrascale">
      <package pattern="TerraScale.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
