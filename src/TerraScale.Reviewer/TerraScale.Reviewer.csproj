<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>TerraScale.Reviewer</AssemblyName>
    <RootNamespace>TerraScale.Reviewer</RootNamespace>
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:11.0-rc.1</ContainerBaseImage>
    <ContainerRepository>terrascale/ts-reviewer</ContainerRepository>
    <ContainerPort>8080</ContainerPort>
    <ContainerUser>1654</ContainerUser>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FastBertTokenizer" Version="0.4.67" />
    <PackageReference Include="LiteDB" Version="6.0.0-prerelease.289" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.17.0" />
    <!-- Supplies the bge-micro-v2 model and vocabulary at build time; ContextEmbedder runs them. -->
    <PackageReference Include="SmartComponents.LocalEmbeddings" Version="0.1.0-preview10148" />
  </ItemGroup>
</Project>
